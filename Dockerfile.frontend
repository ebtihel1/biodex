# Étape 1 : Build Vite
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Supprimer l'import vendor flux.css pour le build Docker
RUN sed -i '/@import.*vendor.*flux\.css/d' resources/css/app.css || true

# Build de l'application
RUN npm run build

# Étape 2 : Production Nginx
FROM nginx:alpine

# Si le build Vite est dans dist (cas standard) ou public/build (cas Laravel Inertia) :
COPY --from=builder /app/public/build /usr/share/nginx/html
# Copie de la configuration Nginx propre si elle existe
COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]